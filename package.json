{
  "name": "dallascarraher.dev-monorepo",
  "private": true,
  "workspaces": [
    "blog",
    "libs/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "spotify:auth": "bun run scripts/spotify-refresh-token.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.11"
}
